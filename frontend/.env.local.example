# ReturnGuard frontend settings template. `python scripts/gen_secrets.py` (run from the
# repo root) creates frontend/.env.local from it for you.
# AUTH_SECRET is the only value that must be set: a random string of 32+ characters.
# KEYCLOAK_CLIENT_SECRET below matches the returnguard-web client in
# infra/keycloak/realm-export.json (a fixed value for local use, not a real secret).

AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
KEYCLOAK_ISSUER=http://localhost:8081/realms/returnguard
KEYCLOAK_CLIENT_ID=returnguard-web
KEYCLOAK_CLIENT_SECRET=VsfOvtq11751C1m5YpVIMP_e6dwLBxin
BACKEND_URL=http://localhost:8000
