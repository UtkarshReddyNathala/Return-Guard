# ReturnGuard settings template. `python scripts/gen_secrets.py` copies it to .env and
# fills in the generated values; you only add the two paid API keys.
# .env is git-ignored. It is only used to load the secrets into Vault and to start the
# infrastructure containers. The backend and worker read every secret from Vault.

# --- paid API keys (you must fill these in) ---
OPENAI_API_KEY=
GROQ_API_KEY=

# --- generated infra credentials (any strong random string) ---
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_NEXTAUTH_SECRET=
NEXTAUTH_SECRET=
CONTEXTFORGE_JWT_SECRET=
BIFROST_ADMIN_TOKEN=

LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=

# --- fixed local values (fine to leave as-is) ---
POSTGRES_USER=returnguard
POSTGRES_DB=returnguard
MINIO_ROOT_USER=returnguard
KEYCLOAK_ADMIN=admin
VAULT_ADDR=http://vault:8200
VAULT_DEV_ROOT_TOKEN_ID=root
